function Prueba_12(registro, valor, robotIP, puerto)
% Consola de valores para un solo registro, sin Python.
% Prueba_12: escribir 30, despues 40; cambia siempre R[180].
% Prueba_12(180): misma consola para R[180].
% Prueba_12(180,30): un cambio directo y verificado.
% El registro debe existir, estar libre y tener mapeo SNPX.
if nargin < 1, registro = 180; end
if nargin < 2, valor = []; end
if nargin < 3, robotIP = '127.0.0.1'; end
if nargin < 4, puerto = 18245; end
% Compatibilidad con el lanzador anterior.
if (ischar(registro) || isstring(registro)) && strcmpi(registro,'terminal')
    registro = 180;
end
modoTerminal = isempty(valor);
validateattributes(registro, {'numeric'}, {'scalar','integer','>=',1,'<=',65536});
if ~modoTerminal
    validateattributes(valor, {'numeric'}, {'scalar','integer','>=',-32768,'<=',32767});
end
validateattributes(puerto, {'numeric'}, {'scalar','integer','>=',1,'<=',65535});

fprintf('Conectando SNPX a %s:%d...\n', robotIP, puerto);
% La conexion vive solo en esta funcion y se libera al terminar o fallar.
cliente = tcpclient(robotIP, puerto, 'Timeout', 10, 'ConnectTimeout', 10);
cierre = onCleanup(@() delete(cliente)); %#ok<NASGU>
% Cerrar explicitamente tambien al fallar o cancelar con Ctrl+C.
respuesta = intercambiar(cliente, zeros(1,56,'uint8'));
if respuesta(1) ~= 1
    error('Prueba_12:Init', 'Respuesta INIT inesperada: %d.', respuesta(1));
end
respuesta = intercambiar(cliente, mensajeLectura(0));
% Offset 47 del driver Python corresponde al indice 48 de MATLAB.
if enteroLE(respuesta(48:49), false) ~= 256
    error('Prueba_12:Conexion', 'Fallo la comprobacion inicial SNPX.');
end

if modoTerminal
    consolaValores(cliente,registro);
    return;
end

anterior = leerRegistro(cliente, registro);
fprintf('Antes: R[%d] = %d\n', registro, anterior);
intercambiar(cliente, mensajeEscritura(registro, valor));
actual = leerRegistro(cliente, registro);
if actual ~= valor
    error('Prueba_12:Verificacion', ...
        'R[%d]: se leyo %d, se esperaba %d. Comprobar mapeo SNPX.', ...
        registro, actual, valor);
end
fprintf('OK: R[%d] = %d (antes %d).\n', registro, actual, anterior);
end

function consolaValores(cliente,registro)
fprintf('Registro fijo: R[%d]. Valor actual: %d.\n', ...
    registro,leerRegistro(cliente,registro));
fprintf('Escribir solo un numero: 30, 40, etc. Para terminar: salir.\n');
while true
    texto = strtrim(input(sprintf('R[%d] nuevo valor> ',registro),'s'));
    if any(strcmpi(texto,{'salir','exit','quit'})), return; end
    if isempty(texto), continue; end
    nuevo = str2double(texto);
    if ~isscalar(nuevo) || ~isreal(nuevo) || ~isfinite(nuevo) ...
            || nuevo ~= fix(nuevo) || nuevo < -32768 || nuevo > 32767
        fprintf('Escribir un entero entre -32768 y 32767, o salir.\n');
        continue;
    end
    previo = leerRegistro(cliente,registro);
    intercambiar(cliente,mensajeEscritura(registro,nuevo));
    leido = leerRegistro(cliente,registro);
    if leido ~= nuevo
        error('Prueba_12:Verificacion', ...
            'R[%d]: se esperaba %d, se leyo %d. Revisar mapeo SNPX.', ...
            registro,nuevo,leido);
    end
    fprintf('OK: R[%d] = %d (antes %d).\n',registro,leido,previo);
end
end

function msg = mensajeBase()
% Misma cabecera de 56 bytes que srtp_message.BASE_MSG.
msg = zeros(1,56,'uint8');
msg([1,3,10,18,31,32,37,38,41,42]) = uint8([2,6,1,1,6,192,16,14,1,1]);
end

function msg = mensajeLectura(registro)
msg = mensajeBase();
msg(43) = 4; % READ_SYS_MEMORY
msg(44) = 8; % WORD %R (mapeado a R del robot)
if registro > 0
    msg(45:46) = wordLE(registro-1);
end
msg(47) = 1;
end

function msg = mensajeEscritura(registro, valor)
msg = mensajeBase();
msg([5,10,18,31,32,43,49,50,51,52,55]) = ...
    uint8([2,2,2,9,128,2,1,1,7,8,1]);
msg(53:54) = wordLE(registro-1);
msg = [msg, wordLE(mod(double(valor),65536))];
end

function valor = leerRegistro(cliente, registro)
respuesta = intercambiar(cliente, mensajeLectura(registro));
if respuesta(1) ~= 3
    error('Prueba_12:Respuesta','Tipo de respuesta de lectura inesperado: %d.',respuesta(1));
end
% Offset 44:46 exclusivo en Python -> indices 45:46 MATLAB.
valor = enteroLE(respuesta(45:46), true);
end

function bytes = wordLE(valor)
bytes = uint8([mod(double(valor),256), floor(double(valor)/256)]);
end

function valor = enteroLE(bytes, signed)
valor = double(bytes(1)) + 256*double(bytes(2));
if signed && valor >= 32768, valor = valor-65536; end
end

function respuesta = intercambiar(cliente, mensaje)
write(cliente, mensaje, 'uint8');
% TCP puede entregar una respuesta en fragmentos: reunir cabecera completa.
respuesta = recibirExacto(cliente,56);
longitud = enteroLE(respuesta(5:6),false);
if longitud > 4096
    error('Prueba_12:Trama','Longitud SNPX inesperada: %d.',longitud);
end
if longitud > 0
    respuesta = [respuesta, recibirExacto(cliente,longitud)];
end
end

function bytes = recibirExacto(cliente, cantidad)
bytes = zeros(1,0,'uint8');
inicio = tic;
while numel(bytes) < cantidad
    disponibles = cliente.NumBytesAvailable;
    if disponibles > 0
        fragmento = read(cliente,min(disponibles,cantidad-numel(bytes)),'uint8');
        bytes = [bytes, reshape(fragmento,1,[])]; %#ok<AGROW>
    else
        if toc(inicio) >= cliente.Timeout
            error('Prueba_12:Timeout', ...
                ['Respuesta SNPX incompleta (%d/%d bytes). ', ...
                 'Si aparece PRIO-096, cerrar otros clientes SNPX ', ...
                 'y liberar las conexiones del controlador antes de reintentar.'], ...
                numel(bytes),cantidad);
        end
        pause(0.01);
    end
end
end
